# Retrieval itself is fully local - no API key required for that part.

# HuggingFace model id (override to pin a different revision/fork)
COLVINTERN_MODEL=5CD-AI/ColVintern-1B-v1

# Directory of document images to index
COLVINTERN_DATA_DIR=data

# Device: 'auto' (detect GPU/MPS/CPU), 'cuda', 'mps', or 'cpu'
COLVINTERN_DEVICE=auto

# Optional: only needed for the answer-generation step (VQA on the matched
# image). Without this, main.py still shows retrieval scores, just no answer.
# Get a free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.6-flash
