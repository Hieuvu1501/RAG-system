# Gemini API Configuration
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
LLM_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001

# Embedding Backend: 'vintern' (local Vintern-Embedding-1B) or 'gemini' (Gemini API)
EMBEDDING_BACKEND=vintern

# Vintern Local Model Configuration
# Model name from HuggingFace (downloaded automatically on first use)
VINTERN_MODEL=5CD-AI/Vintern-Embedding-1B
# Device: 'auto' (detect GPU/CPU), 'cuda', 'mps', or 'cpu'
VINTERN_DEVICE=auto

# Retrieval & Fusion Parameters
TOP_K_SPARSE=5
TOP_K_DENSE=5
RRF_K=60
TOP_N_RERANK=3

# TruLens RAG Triad Evaluation
# Set to 'false' to skip evaluation (faster, no extra API calls)
ENABLE_TRIAD_EVAL=true
# Model used as LLM-as-a-Judge for scoring (can be faster/cheaper than LLM_MODEL)
TRIAD_EVAL_MODEL=gemini-3.6-flash
